# Copy to ".env" (gitignored) and adjust. docker-compose loads it automatically.

# Ship service logs to CloudWatch Logs. Set to false to turn it off.
ATHENA_LOGGING_CLOUDWATCH_ENABLED=true

# Where the services reach CloudWatch Logs. LocalStack is NOT part of the compose
# stack — run it yourself, e.g.:
#   docker run --rm -it -p 4566:4566 -e LOCALSTACK_AUTH_TOKEN=ls-... localstack/localstack-pro:latest
# Default points at a host-run LocalStack; override for real AWS or a different host.
# ATHENA_LOGGING_CLOUDWATCH_ENDPOINT=http://host.docker.internal:4566
