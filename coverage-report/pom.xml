<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.athena</groupId>
        <artifactId>athena-backend-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>coverage-report</artifactId>
    <packaging>pom</packaging>
    <name>Athena Coverage Aggregate Report</name>
    <description>Reactor-wide JaCoCo aggregate report. Produces a single HTML+XML coverage view
        across every Athena module. Contains no production code.</description>

    <dependencies>
        <dependency>
            <groupId>com.athena</groupId>
            <artifactId>athena-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.athena</groupId>
            <artifactId>athena-llm</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.athena</groupId>
            <artifactId>discovery-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.athena</groupId>
            <artifactId>api-gateway</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.athena</groupId>
            <artifactId>auth-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.athena</groupId>
            <artifactId>user-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.athena</groupId>
            <artifactId>progress-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.athena</groupId>
            <artifactId>learning-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.athena</groupId>
            <artifactId>badge-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.athena</groupId>
            <artifactId>ai-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.athena</groupId>
            <artifactId>interview-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.athena</groupId>
            <artifactId>rag-service</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>aggregate-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <title>Athena Backend — Aggregate Coverage</title>
                            <excludes>
                                <exclude>**/*Application.class</exclude>
                                <exclude>**/config/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
